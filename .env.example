# Salin menjadi .env.local untuk development. JANGAN commit file berisi password asli.

# Koneksi MySQL / MariaDB
#   Di Hostinger (produksi) gunakan DB_HOST=127.0.0.1 dan DB_PORT=3306,
#   dan isi variabel ini lewat hPanel → Node.js → Environment variables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Akun admin pertama — hanya dipakai bila tabel admin_users masih KOSONG.
# Setelah akun terbentuk, variabel ini boleh dihapus.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
